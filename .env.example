# SMKPI — variáveis de ambiente
# Copie para .env.local e preencha.

# ── Supabase (Project Settings → API) ───────────────────────────────────────
# URL e anon key do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# ── Google AI (Gemini) — opcional ──────────────────────────────────────────
# Chave criada em https://aistudio.google.com/apikey
# Usada para sugerir etapas, metas e analisar a evolução.
GOOGLE_API_KEY=sua-chave-do-gemini-aqui
